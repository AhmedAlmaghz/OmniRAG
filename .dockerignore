# Never bake secrets into the image — they are injected at runtime.
.env
.env.*
!.env.example

# Version control & CI
.git
.github
.husky
.zcode
.kilo

# Dependencies (installed fresh inside the image, pruned to production).
node_modules
dist
coverage
*.tsbuildinfo

# The PREBUILT .next bundle IS the image payload (host-build + pack flow,
# v0.12.21) — it must reach the build context. Only its runtime cache is
# excluded: the image recreates .next/cache with correct ownership.
.next/cache

# Local runtime artifacts
terminal_logs
*.log

# Not needed inside the image (docs, local experiments, dev-only tooling).
# NOTE: *.traineddata OCR models ARE included — the runner bakes them for
# offline OCR; config files (next.config.ts, server.ts) are runtime-required.
SDLC
assets
docs
scripts
agent-evolution-deck
dev-server.js
COMPREHENSIVE_REPORT.md
REPORT_AND_PLAN.md
REPORT_AND_PLAN_2026-08-15.md
todo.md
.todo.json
test-*.js
test-*.ts
seed_patch.cjs
metadata.json
deploy-live.log
