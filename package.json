{
  "name": "OmniRAG",
  "private": true,
  "version": "0.12.8",
  "homepage": "https://omnirag-segma.vercel.app",
  "github": "https://github.com/AhmedAlmaghz/omnirah",
  "author": "Ahmed Almaghz",
  "type": "module",
  "scripts": {
    "dev": "node dev-server.js",
    "build": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=production next build",
    "start": "node server.ts",
    "clean": "rimraf .next dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:check": "drizzle-kit check --config=src/db/drizzle.config.ts",
    "db:migrate:manual": "tsx scripts/run-manual-migration.ts",
    "db:verify-rls": "tsx scripts/verify-rls.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"*.{ts,js,mjs,cjs,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"*.{ts,js,mjs,cjs,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/groq": "^4.0.31",
    "@ai-sdk/mcp": "^2.0.37",
    "@ai-sdk/mistral": "^4.0.33",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@ai-sdk/react": "^4.0.86",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.1.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "@remotion/player": "^4.0.512",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.66",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "html2canvas-pro": "^2.3.9",
    "imapflow": "^1.7.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "katex4arabic": "^1.1.8",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "mermaid": "^11.17.0",
    "motion": "^13.1.0",
    "mysql2": "^3.24.2",
    "next": "^16.3.1",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "pg-boss": "^12.28.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remotion": "^4.0.512",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.29.0",
    "youtube-captions-scraper": "^2.0.3",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
