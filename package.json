{
  "name": "OmniRAG",
  "private": true,
  "version": "0.4.5",
  "author": "Ahmed Almaghz",
  "type": "module",
  "scripts": {
    "dev": "node dev-server.js",
    "build": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=1536 NODE_ENV=production next build",
    "start": "node server.ts",
    "clean": "rimraf .next dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"*.{ts,js,mjs,cjs,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"*.{ts,js,mjs,cjs,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.39",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^1.20.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "@remotion/player": "^4.0.507",
    "@types/pdf-parse": "^1.1.5",
    "ai": "^7.0.58",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^14.2.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.1",
    "motion": "^11.15.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remotion": "^4.0.507",
    "tailwind-merge": "^2.5.5",
    "youtube-captions-scraper": "^2.0.3",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
