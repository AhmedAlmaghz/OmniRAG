# Local runtime object storage (uploads/parse artifacts) — never commit.
# Root-anchored: `storage/` unanchored would also match src/lib/storage/ (source!).
/storage/
# Local agent-tool workspace (ships its own node_modules).
/.kilo/

# TypeScript incremental build artifacts — must not be committed (stale
# tsbuildinfo causes misleading CI typecheck results across machines).
*.tsbuildinfo
# Tesseract OCR language models — downloaded & cached at runtime by
# tesseract.js (never commit these binary artifacts).
*.traineddata
