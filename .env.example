# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://omnirag-segma.vercel.app/"

# PostgreSQL connection string for Lexical Search / metadata
DATABASE_URL="postgresql://username:password@hostname:port/dbname?sslmode=require"

# ── Row Level Security activation (OPTIONAL, recommended) ───────────────────
# When set, the runtime data pool connects as this LEAST-PRIVILEGE role and the
# tenant-isolation RLS policies are ENFORCED (the owner connection above is
# then used only for migrations/DDL/seeds). When empty, runtime falls back to
# the owner connection and RLS stays dormant (owner bypass). The role is
# created/granted automatically on boot; set APP_DB_PASSWORD to let the boot
# migration give it LOGIN with this password (docker compose does both).
#   CREATE ROLE omnirag_app LOGIN PASSWORD '…';  ← or let the app do it
DATABASE_APP_URL=""
APP_DB_PASSWORD=""

# Qdrant URL and optional API key for Vector Semantic Search
QDRANT_URL="https://your-qdrant-cluster.qdrant.tech"
QDRANT_API_KEY="your_qdrant_api_key"

# Mistral Document AI API Key for OCR & Layout Parsing
MISTRAL_API_KEY=""

# Unstructured document extraction. Two supported generations — the engine
# routes automatically by which URL is configured:
#   • Modern Transform Platform (Platform API key from unstructured.io):
#     UNSTRUCTURED_API_URL="https://platform-api.transform.unstructured.io/api/v1"
#     → async Jobs API flow (create job → poll → download elements).
#   • Legacy Partition API (classic API key):
#     UNSTRUCTURED_API_URL="https://api.unstructuredapp.io/general/v0/general"
#     → synchronous direct POST.
# Note: the two key systems are separate — pair each key with ITS URL.
UNSTRUCTURED_API_KEY=""
UNSTRUCTURED_API_URL="https://platform-api.transform.unstructured.io/api/v1"

# Groq API Key for Whisper-3 audio/video transcription
GROQ_API_KEY=""

# ── MCP live web search (OPTIONAL) ──────────────────────────────────────────
# Enables the `web_live_search` MCP tool used by the chat agent and the MCP
# gateway. The FIRST configured provider wins; when none is set the tool
# degrades to an honest "not configured" result instead of fake data.
#   Tavily  — https://tavily.com  (recommended, generous free tier)
#   Serper  — https://serper.dev  (Google results)
#   Brave   — https://brave.com/search/api/
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_API_KEY=""

# CORS: comma-separated list of allowed origins for the API (production).
# e.g. "https://omnirag.example.com,https://app.omnirag.example.com"
ALLOWED_ORIGINS="https://omnirag-segma.vercel.app"

# MCP_OAUTH_ENCRYPTION_KEY: AES-256-GCM key for encrypting OAuth tokens and
# connector credentials at rest. REQUIRED in production — the app refuses to
# encrypt credentials at runtime if this is unset when NODE_ENV=production,
# rather than silently using the dev-only fallback key committed in the repo.
# Generate one with: openssl rand -base64 32
# NEVER commit a real key here — this file is tracked in git.
MCP_OAUTH_ENCRYPTION_KEY=""

# Allow client-supplied environment variables via x-env-* headers.
# Disabled in production unless explicitly set to "true" (not recommended).
ALLOW_CLIENT_ENV="false"

# Self-serve PLAN UPGRADES via PUT /api/v1/plan. Until a billing provider is
# wired, upgrades are locked by default so no owner can grant themselves the
# unlimited enterprise tier for free. Downgrades are always self-serve.
# Set to "true" only for internal/demo deployments.
PLAN_SELF_SERVE="false"

# ── Large-file direct upload (OPTIONAL) ─────────────────────────────────────
# Files larger than ~3.5 MB are uploaded directly from the browser to object
# storage so they never hit hosting body limits (e.g. Vercel's 4.5 MB
# FUNCTION_PAYLOAD_TOO_LARGE). Two optional providers — when NEITHER is
# configured the app falls back to the classic direct POST, which works on
# hosts without body limits (Cloud Run, Docker, self-hosted…).
#
# 1) Any S3-compatible store — Tigris, AWS S3, Cloudflare R2, MinIO…
#    Works on ANY host (Vercel included) and takes priority when configured.
S3_ENDPOINT=""                    # Tigris: https://t3.storage.dev
S3_REGION="auto"                  # Tigris: auto | AWS: e.g. us-east-1
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"        # true for Tigris/MinIO; false for virtual-host style
# NOTE: the bucket must allow CORS PUT (and the app origin) from the browser;
# the server reads/deletes objects via presigned URLs and needs no CORS.
#
# 2) Vercel Blob — only used when the app is hosted on Vercel (VERCEL=1)
#    and a Blob store is connected in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""



