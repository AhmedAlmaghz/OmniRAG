# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://omnirag-sigma.vercel.app/"

# PostgreSQL connection string for Lexical Search / metadata
DATABASE_URL="postgresql://username:password@hostname:port/dbname?sslmode=require"

# Qdrant URL and optional API key for Vector Semantic Search
QDRANT_URL="https://your-qdrant-cluster.qdrant.tech"
QDRANT_API_KEY="your_qdrant_api_key"

# Mistral Document AI API Key for OCR & Layout Parsing
MISTRAL_API_KEY=""

# Unstructured API Key for advanced MCP / transform document extraction
UNSTRUCTURED_API_KEY=""

# Groq API Key for Whisper-3 audio/video transcription
GROQ_API_KEY=""

# CORS: comma-separated list of allowed origins for the API (production).
# e.g. "https://omnirag.example.com,https://app.omnirag.example.com"
ALLOWED_ORIGINS="https://omnirag-sigma.vercel.app"

# Demo mode: set to "false" to reject demo (non-Firebase) auth tokens.
# Demo mode is automatically disabled in production (NODE_ENV=production).
AUTH_ALLOW_DEMO="false"

# MCP_OAUTH_ENCRYPTION_KEY: AES-256-GCM key for encrypting OAuth tokens and
# connector credentials at rest. REQUIRED in production — the app refuses to
# encrypt credentials at runtime if this is unset when NODE_ENV=production,
# rather than silently using the dev-only fallback key committed in the repo.
# Generate one with: openssl rand -base64 32
MCP_OAUTH_ENCRYPTION_KEY="adweeeqel;mclemkd[wqpl0qiwkqwjmdlqwd]"

# Allow client-supplied environment variables via x-env-* headers.
# Disabled in production unless explicitly set to "true" (not recommended).
ALLOW_CLIENT_ENV="false"

# Firebase Admin service account — REQUIRED on non-GCP hosts (e.g. Vercel) to
# verify ID tokens server-side. On GCP runtimes Application Default Credentials
# are used automatically when this is unset.
# Paste the ENTIRE service-account JSON (from Firebase Console > Project
# settings > Service accounts > Generate new private key) as a single value;
# keep it on one line (JSON.stringify). Store it as a Vercel project secret —
# never commit the key.
FIREBASE_SERVICE_ACCOUNT_KEY=""



