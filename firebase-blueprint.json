{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Multi-tenant workspace configuration and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique tenant identifier" },
        "name": { "type": "string", "description": "Workspace name" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" }
      },
      "required": ["id", "name", "plan", "createdAt"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Logical grouping of knowledge documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "documentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "name", "createdAt"]
    },
    "Document": {
      "title": "Document",
      "description": "Ingested document metadata and content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "sourceType": { "type": "string" },
        "language": { "type": "string" },
        "status": { "type": "string" },
        "chunkCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "title", "createdAt"]
    },
    "DocumentChunk": {
      "title": "DocumentChunk",
      "description": "Indexed vector/text chunk for hybrid search",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "documentId": { "type": "string" },
        "documentTitle": { "type": "string" },
        "content": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "language": { "type": "string" }
      },
      "required": ["id", "tenantId", "documentId", "content"]
    },
    "MCPServerConfig": {
      "title": "MCPServerConfig",
      "description": "Model Context Protocol server integration setup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "sandboxTier": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "tenantId", "name", "endpointUrl"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Deterministic HookHarness security and audit event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "action", "status", "timestamp"]
    },
    "SourceConnector": {
      "title": "SourceConnector",
      "description": "External data source connector definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "name", "type"]
    },
    "SyncLogEntry": {
      "title": "SyncLogEntry",
      "description": "Log entry for data source synchronization runs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "sourceId": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "sourceId", "status", "timestamp"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Tenant organization root document"
    },
    "/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/Collection" },
      "description": "Knowledge collections"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/Document" },
      "description": "Ingested documents"
    },
    "/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/DocumentChunk" },
      "description": "Document text and embedding chunks"
    },
    "/mcp_servers/{serverId}": {
      "schema": { "$ref": "#/entities/MCPServerConfig" },
      "description": "MCP gateway servers"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Security audit logs"
    },
    "/sources/{sourceId}": {
      "schema": { "$ref": "#/entities/SourceConnector" },
      "description": "External source connectors"
    },
    "/sync_logs/{logId}": {
      "schema": { "$ref": "#/entities/SyncLogEntry" },
      "description": "Sync execution logs"
    }
  }
}
